# Unsplash API Integration
# Get your Access Key at: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Output & Attribution Paths
OUTPUT_DIR=./thumbnails
ATTRIBUTIONS_FILE=./thumbnails/attributions.txt

# Branding & Assets
DEFAULT_WEBSITE=sagunto.adventista.es
WATERMARK_FILE=assets/right_sidebar_watermark.png
LOGO_FILE=assets/logo_watermark_bold.png

# Optional: Custom font path override (defaults to segoe-ui-black.ttf / system Segoe UI)
# FONT_FILE=segoe-ui-black.ttf
